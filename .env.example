# Copy to .env (never commit it). Read by the API container via docker compose.
ANTHROPIC_API_KEY=

# Serving layer (src/analyst_agent/api/settings.py)
AGENT_MAX_CONCURRENT_JOBS=4
AGENT_MAX_UPLOAD_MB=50
# AGENT_JOB_DB_PATH=            # empty = in-memory only

# Human-in-the-loop approval (src/analyst_agent/core/approval.py); off by default
AGENT_APPROVAL_ENABLED=false
# AGENT_APPROVAL_ROW_THRESHOLD=1000000
# AGENT_APPROVAL_PYTHON=true
# AGENT_APPROVAL_BUDGET_FRACTION=0.8
# AGENT_APPROVAL_TIMEOUT_S=300

# Observability (docs/observability.md)
AGENT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Semantic layer (src/analyst_agent/semantic): inject governed metric definitions into the
# planner prompt. benchmarks/ is not in the Docker image; mount metrics and point the dir at them.
AGENT_SEMANTIC_LAYER_ENABLED=false
# AGENT_SEMANTIC_METRICS_DIR=benchmarks/metrics
# AGENT_SEMANTIC_TOP_K=4
# Model routing (docs/model-routing.md); off by default
AGENT_ROUTING_ENABLED=false
# AGENT_ROUTER_MODEL=claude-haiku-5-5
# AGENT_MODEL_L1=claude-sonnet-5-5   # each tier defaults to AGENT_MODEL
# AGENT_MODEL_L2=
# AGENT_MODEL_L3=
