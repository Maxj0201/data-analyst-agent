# Copy to .env (never commit it). Read by the CLI, the eval harness and the API container
# (docker compose). Every AGENT_* variable is a field of analyst_agent.core.config.Settings and is
# documented in docs/configuration.md; commented lines show the default. An empty value means
# "unset" for optional settings.

ANTHROPIC_API_KEY=

# --- Agent core
# AGENT_MODEL=claude-opus-5-5
# AGENT_CRITIC_MODEL=
# AGENT_EFFORT=high
# AGENT_MAX_TOKENS=16000
# AGENT_REFUSAL_FALLBACK=true
# AGENT_MAX_TURNS=15
# AGENT_TOKEN_BUDGET=400000
# AGENT_MAX_CRITIC_ROUNDS=2
# AGENT_MAX_RETRIES=4
# AGENT_RETRY_BASE_DELAY=1.0
# AGENT_RETRY_MAX_DELAY=30.0
# AGENT_ARTIFACTS_DIR=artifacts
# AGENT_MAX_TOOL_OUTPUT_CHARS=20000

# --- Model routing
AGENT_ROUTING_ENABLED=false
# AGENT_ROUTER_MODEL=claude-haiku-5-5
# AGENT_ROUTER_EFFORT=low
# AGENT_ROUTER_MAX_TOKENS=1024
# AGENT_MODEL_L1=
# AGENT_MODEL_L2=
# AGENT_MODEL_L3=
# AGENT_ROUTER_FALLBACK_TIER=L3

# --- Semantic layer
AGENT_SEMANTIC_LAYER_ENABLED=false
# AGENT_SEMANTIC_METRICS_DIR=benchmarks/metrics
# AGENT_SEMANTIC_TOP_K=4

# --- Structured report
AGENT_STRUCTURED_REPORT_ENABLED=false

# --- Insight memory
AGENT_MEMORY_ENABLED=false
# AGENT_MEMORY_DB_PATH=data/memory.sqlite3
# AGENT_MEMORY_TOP_K=3

# --- Human-in-the-loop
AGENT_APPROVAL_ENABLED=false
# AGENT_APPROVAL_ROW_THRESHOLD=1000000
# AGENT_APPROVAL_PYTHON=true
# AGENT_APPROVAL_BUDGET_FRACTION=0.8
# AGENT_APPROVAL_TIMEOUT_S=300.0

# --- API
# AGENT_DATA_DIR=data
# AGENT_JOB_DB_PATH=data/jobs.sqlite3
# AGENT_JOB_MEMORY_LIMIT=500
# AGENT_MAX_CONCURRENT_JOBS=4
# AGENT_MAX_UPLOAD_MB=50
AGENT_LANGFUSE_ENABLED=false
# AGENT_CORS_ORIGINS=[]

# --- Eval
# AGENT_JUDGE_MODEL=
# AGENT_JUDGE_EFFORT=low
# AGENT_EVAL_CONCURRENCY=4
# AGENT_EVAL_TIMEOUT_S=300.0
# AGENT_EVAL_RUNS_DIR=runs

# --- Observability keys (read by the Langfuse SDK when AGENT_LANGFUSE_ENABLED=true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Streamlit frontend (read by frontend/app.py, which runs without the agent package)
# AGENT_API_URL=http://localhost:8000
# AGENT_API_ID_TOKEN=false
