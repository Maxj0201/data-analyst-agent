# Copy to .env (never commit it). Read by the API container via docker compose.
ANTHROPIC_API_KEY=

# Serving layer (src/analyst_agent/api/settings.py)
AGENT_MAX_CONCURRENT_JOBS=4
AGENT_MAX_UPLOAD_MB=50
# AGENT_JOB_DB_PATH=            # empty = in-memory only

# Observability (docs/observability.md)
AGENT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
